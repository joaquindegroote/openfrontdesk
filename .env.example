# Copy to .env and fill in. Never commit .env.

# The key for the provider of the models below. Both can be set.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Models: an OpenAI chat model with tool calling, or a Claude model ("claude-...").
OFD_LLM_MODEL=gpt-5-mini
OFD_JUDGE_MODEL=gpt-5-mini
# Reasoning effort (minimal, low, medium, high); Claude treats minimal as low.
# Leave empty for models without it.
OFD_LLM_REASONING_EFFORT=low
OFD_JUDGE_REASONING_EFFORT=low

# Where the engine finds the business system (the mock clinic API in local dev).
OFD_BACKEND_URL=http://127.0.0.1:8001

# SQLite for local dev; docker compose switches this to Postgres.
OFD_DATABASE_URL=sqlite+aiosqlite:///./openfrontdesk.db

# Which business the assistant works for.
OFD_BUSINESS_PROFILE=businesses/brightsmile-dental/profile.yaml

# Integrations that open WhatsApp/SMS/voice conversations send this as X-Integration-Key.
# Leave unset only for a local demo: then any client can claim a verified channel.
# OFD_INTEGRATION_KEY=

# Optional: send traces to Arize Phoenix (started by docker compose).
# OFD_OTLP_ENDPOINT=http://localhost:6006/v1/traces
